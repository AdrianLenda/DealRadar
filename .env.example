# DealRadar secrets — copy to .env and fill in. Never put these in config/*.yaml (config.py only
# reads secrets from the environment; python-dotenv loads this file into the environment at startup
# if present). .env itself is git-ignored.

# Allegro REST API — OAuth2 client credentials (owner: A1, collectors/allegro_api.py)
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=

# AliExpress affiliate API — optional; collector must disable itself gracefully when unset (owner: A1)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# Amazon Product Advertising API 5.0 — requires an approved Amazon Associates account (not a generic AWS
# IAM account). AMAZON_ACCESS_KEY / AMAZON_SECRET_KEY come from your Associates account's PA-API
# credentials page; AMAZON_PARTNER_TAG is your Associate/Store ID (the tag= value in your affiliate links).
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Outbound email notifications (owner: A6, reporting/notifiers)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Telegram notifications (owner: A6, reporting/notifiers)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional override for the database connection string; defaults to a local sqlite file.
DEALRADAR_DATABASE_URL=
